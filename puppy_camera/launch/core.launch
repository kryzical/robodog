<?xml version="1.0"?>
<!-- Core launch file for running camera node without visualization -->
<launch>
  <!-- Camera parameters -->
  <arg name="camera_device_id" default="0"/>
  <arg name="frame_rate" default="30"/>
  <arg name="frame_id" default="camera_link"/>
  
  <!-- Set ROS_IP if provided -->
  <arg name="ros_ip" default=""/>
  <group if="$(eval ros_ip != '')">
    <env name="ROS_IP" value="$(arg ros_ip)"/>
    <env name="ROS_HOSTNAME" value="$(arg ros_ip)"/>
  </group>

  <!-- Launch the camera node -->
  <node name="camera_node" pkg="puppy_camera" type="camera_node.py" output="screen">
    <param name="camera_device_id" value="$(arg camera_device_id)"/>
    <param name="frame_rate" value="$(arg frame_rate)"/>
    <param name="frame_id" value="$(arg frame_id)"/>
  </node>
</launch>