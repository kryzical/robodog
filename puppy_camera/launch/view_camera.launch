<launch>
  <!-- Launch RViz with camera view configuration -->
  <node name="rviz" pkg="rviz" type="rviz" args="-d $(find puppy_camera)/config/camera_view.rviz"/>

  <!-- Optionally launch image_view for a lighter-weight alternative -->
  <node name="image_view" pkg="image_view" type="image_view" respawn="false" output="screen">
    <remap from="image" to="/camera/image_raw"/>
  </node>
</launch>