<?xml version="1.0"?>
<launch>
  <!-- Launch Gazebo with the puppy model -->
  <include file="$(find puppy_description)/launch/gazebo_with_urdf.launch"/>
  
  <!-- Launch RViz to visualize the robot (optional) -->
  <include file="$(find puppy_description)/launch/rviz_with_urdf.launch"/>
  
  <!-- Launch the unified controller -->
  <node name="unified_robot_controller" pkg="puppy_description" type="unified_controller.py" output="screen"/>
</launch>