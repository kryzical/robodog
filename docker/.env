# ROS2 Configuration
ROS_DISTRO=${ROS_DISTRO:-humble}
ROS_DOMAIN_ID=${ROS_DOMAIN_ID:-0}

# Gazebo Configuration
GAZEBO_VERSION=${GAZEBO_VERSION:-fortress}
GAZEBO_MODEL_PATH=${GAZEBO_MODEL_PATH:-/workspace/src/puppy_description}
GAZEBO_RESOURCE_PATH=${GAZEBO_RESOURCE_PATH:-/workspace/src/puppy_description}
IGN_GAZEBO_RESOURCE_PATH=${IGN_GAZEBO_RESOURCE_PATH:-/workspace/src/puppy_description}
IGN_GAZEBO_SYSTEM_PLUGIN_PATH=${IGN_GAZEBO_SYSTEM_PLUGIN_PATH:-/usr/lib/x86_64-linux-gnu/ign-gazebo-6/plugins}

# X11 Configuration
DISPLAY=${DISPLAY:-:0}
XAUTHORITY=${XAUTHORITY:-$HOME/.Xauthority}

# Workspace Configuration
WORKSPACE_PATH=${WORKSPACE_PATH:-$(pwd)/..}

# Docker Configuration
GITHUB_USERNAME=${GITHUB_USERNAME:-yourusername}
TAG=${TAG:-latest} 