# syntax=docker/dockerfile:1.4

# Stage 1: Base image with ROS 2 Humble
FROM ros:humble-ros-base-jammy AS base
ENV DEBIAN_FRONTEND=noninteractive

# Stage 2: Install Gazebo and control packages (can run in parallel)
FROM base AS gazebo_deps
RUN apt-get update && apt-get install -y --no-install-recommends \
    ros-humble-gazebo-ros \
    ros-humble-gazebo-ros-pkgs \
    ros-humble-ros2-control \
    ros-humble-ros2-controllers \
    ros-humble-controller-manager \
    ros-humble-joint-state-broadcaster \
    ros-humble-robot-state-publisher \
    ros-humble-xacro \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* \
    && rm -rf /tmp/* /var/tmp/*

# Stage 3: Install visualization and Python packages (can run in parallel)
FROM base AS viz_deps
RUN apt-get update && apt-get install -y --no-install-recommends \
    ros-humble-rviz2 \
    ros-humble-cv-bridge \
    python3-pip \
    python3-opencv \
    python3-numpy \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* \
    && rm -rf /tmp/* /var/tmp/*

# Final stage: Combine everything
FROM base
COPY --from=gazebo_deps /opt/ros/humble/ /opt/ros/humble/
COPY --from=viz_deps /opt/ros/humble/ /opt/ros/humble/
COPY --from=gazebo_deps /usr/lib/ /usr/lib/
COPY --from=viz_deps /usr/lib/ /usr/lib/
COPY --from=gazebo_deps /usr/local/ /usr/local/
COPY --from=viz_deps /usr/local/ /usr/local/

# Create workspace
WORKDIR /ros_ws

# Setup shell environment
RUN echo "source /opt/ros/humble/setup.bash" >> ~/.bashrc

# Default command
CMD ["bash"] 