<?xml version="1.0"?>
<launch>
    <!-- Start Gazebo paused to prevent movement during initialization -->
    <include file="$(find gazebo_ros)/launch/empty_world.launch">
      <arg name="world_name" value="$(find puppy_description)/worlds/empty.world"/>
      <arg name="debug" value="false" />
      <arg name="gui" value="true" />
      <arg name="paused" value="true"/> <!-- Start paused to ensure proper initialization -->
      <arg name="use_sim_time" value="true"/>
      <arg name="headless" value="false"/>
    </include>

    <!-- Set Gazebo physics parameters -->
    <param name="/gazebo/max_step_size" value="0.001"/>
    <param name="/gazebo/real_time_update_rate" value="1000"/>
    
    <param name="robot_description" command="$(find xacro)/xacro $(find puppy_description)/urdf/puppy.urdf.xacro"/>

    <!-- Spawn the robot on ground with stable position -->
    <node name="urdf_spawner" pkg="gazebo_ros" type="spawn_model" respawn="false" output="screen"
          args="-urdf -model puppy -param robot_description -z -0.04
                -J joint1 -0.4 -J joint5 1.2
                -J joint2 -0.4 -J joint6 1.2
                -J joint3 0.4 -J joint7 1.2
                -J joint4 0.4 -J joint8 1.2"/>

    <!-- Load controllers -->
    <rosparam file="$(find puppy_description)/config/gazebo_control.yaml" command="load"/>

    <!-- Set initial controller positions to match spawn positions -->
    <param name="/puppy/joint1_position_controller/command" value="-0.4" type="double"/>
    <param name="/puppy/joint2_position_controller/command" value="-0.4" type="double"/>
    <param name="/puppy/joint3_position_controller/command" value="0.4" type="double"/>
    <param name="/puppy/joint4_position_controller/command" value="0.4" type="double"/>
    <param name="/puppy/joint5_position_controller/command" value="1.2" type="double"/>
    <param name="/puppy/joint6_position_controller/command" value="1.2" type="double"/>
    <param name="/puppy/joint7_position_controller/command" value="1.2" type="double"/>
    <param name="/puppy/joint8_position_controller/command" value="1.2" type="double"/>
                          
    <!-- Robot state publisher -->
    <node name="robot_state_publisher" pkg="robot_state_publisher" type="robot_state_publisher" respawn="false" output="screen">
      <param name="publish_rate" value="30"/>
      <remap from="/joint_states" to="/puppy/joint_states" />
    </node>
    
    <!-- Start controllers - ONLY ONCE -->
    <node name="controller_spawner" pkg="controller_manager" type="spawner" respawn="false" ns="/puppy"
          output="screen" args="joint_state_controller
                                joint1_position_controller
                                joint2_position_controller
                                joint3_position_controller
                                joint4_position_controller
                                joint5_position_controller
                                joint6_position_controller
                                joint7_position_controller
                                joint8_position_controller"
          launch-prefix="bash -c 'sleep 2; $0 $@'"/>
    
    <!-- Create position stabilizer script if it doesn't exist -->
    <node pkg="rosservice" type="rosservice" name="position_holder" 
          args="call --wait /gazebo/pause_physics"
          launch-prefix="bash -c 'sleep 4; $0 $@'" />
          
    <!-- Unpause physics only after everything is ready -->
    <node name="unpause_physics" pkg="rostopic" type="rostopic" 
          args="pub -1 /gazebo/unpause_physics std_msgs/Empty '{}'" 
          launch-prefix="bash -c 'sleep 7; $0 $@'" />
</launch>