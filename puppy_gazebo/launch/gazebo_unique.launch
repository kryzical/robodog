<?xml version="1.0"?>
<launch>
    <!-- Start by killing any existing Gazebo process -->
    <node name="gazebo_killer" pkg="rostopic" type="rostopic" 
          args="pub -1 /gazebo/reset_simulation std_msgs/Empty '{}'" 
          output="screen" if="$(optenv RESET_GAZEBO false)"/>
    
    <!-- Start Gazebo with more reliable settings -->
    <include file="$(find gazebo_ros)/launch/empty_world.launch">
      <arg name="world_name" value="$(find puppy_description)/worlds/empty.world"/>
      <arg name="debug" value="false" />
      <arg name="gui" value="true" />
      <arg name="paused" value="false"/> <!-- Start unpaused -->
      <arg name="use_sim_time" value="true"/>
      <arg name="headless" value="false"/>
      <arg name="verbose" value="true"/> <!-- Output more debugging info -->
    </include>
    
    <!-- Generate a unique model name using timestamp -->
    <param name="model_name" command="bash -c 'echo puppy_$(date +%s)'" />
    
    <!-- Load the robot description -->
    <param name="robot_description" command="$(find xacro)/xacro $(find puppy_description)/urdf/puppy.urdf.xacro"/>
    
    <!-- Load controllers configuration -->
    <rosparam file="$(find puppy_description)/config/gazebo_control.yaml" command="load"/>
    
    <!-- Wait for Gazebo to fully initialize -->
    <node pkg="rostopic" type="rostopic" name="wait_for_gazebo" 
          args="pub -1 /wait_for_gazebo std_msgs/Empty '{}'"
          launch-prefix="bash -c 'sleep 3; $0 $@'" />
    
    <!-- Spawn the robot with unique name -->
    <node name="urdf_spawner" pkg="gazebo_ros" type="spawn_model" 
          args="-urdf -model $(arg model_name) -param robot_description -z 0.18
                -J rf_joint1 -0.1 -J lf_joint1 0.1 -J rb_joint1 -0.1 -J lb_joint1 0.1
                -J rf_joint2 1.0 -J lf_joint2 1.0 -J rb_joint2 1.7 -J lb_joint2 1.7"
          respawn="false" output="screen"
          launch-prefix="bash -c 'sleep 5; $0 $@'" />
    
    <!-- Robot state publisher -->
    <node name="robot_state_publisher" pkg="robot_state_publisher" type="robot_state_publisher" 
          respawn="false" output="screen">
      <param name="publish_rate" value="50"/>
      <param name="ignore_timestamp" value="true"/>
      <remap from="/joint_states" to="/puppy/joint_states" />
    </node>
    
    <!-- Load controllers separately for better stability -->
    <!-- First load the joint state controller -->
    <node name="controller_spawner_state" pkg="controller_manager" type="spawner" 
          respawn="false" ns="/puppy" output="screen" 
          args="joint_state_controller"
          launch-prefix="bash -c 'sleep 10; $0 $@'" />
    
    <!-- Then load the position controllers -->
    <node name="controller_spawner_joints" pkg="controller_manager" type="spawner" 
          respawn="false" ns="/puppy" output="screen" 
          args="--timeout 60
                joint1_position_controller
                joint2_position_controller
                joint3_position_controller
                joint4_position_controller
                joint5_position_controller
                joint6_position_controller
                joint7_position_controller
                joint8_position_controller"
          launch-prefix="bash -c 'sleep 15; $0 $@'" />
    
    <!-- Run the initialize_position script -->
    <node name="initialize_position" pkg="puppy_gazebo" type="initialize_position.py" 
          output="screen"
          launch-prefix="bash -c 'sleep 20; chmod +x /workspace/src/puppy_gazebo/scripts/initialize_position.py; $0 $@'" />
</launch> 