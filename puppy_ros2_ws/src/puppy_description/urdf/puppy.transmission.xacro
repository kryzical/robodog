<?xml version="1.0" ?>
<robot name="puppy" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- ROS2 Control transmission format -->

  <!-- Define ros2_control tag for the robot -->
  <ros2_control name="PuppyHardware" type="system">
    <hardware>
      <plugin>gazebo_ros2_control/GazeboSystem</plugin>
    </hardware>

    <!-- ROS2 Control Joint configuration -->
    <xacro:macro name="joint_control" params="joint_name">
      <joint name="${joint_name}">
        <command_interface name="position"/>
        <command_interface name="velocity"/>
        <command_interface name="effort"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
    </xacro:macro>

    <!-- Apply control to all joints -->
    <xacro:joint_control joint_name="lf_joint1"/>
    <xacro:joint_control joint_name="lf_joint2"/>
    <xacro:joint_control joint_name="lb_joint1"/>
    <xacro:joint_control joint_name="lb_joint2"/>
    <xacro:joint_control joint_name="rf_joint1"/>
    <xacro:joint_control joint_name="rf_joint2"/>
    <xacro:joint_control joint_name="rb_joint1"/>
    <xacro:joint_control joint_name="rb_joint2"/>
  </ros2_control>

  <!-- Legacy transmission blocks for compatibility -->
  <xacro:macro name="transmission_block" params="joint_name">
    <transmission name="${joint_name}_trans">
      <type>transmission_interface/SimpleTransmission</type>
      <joint name="${joint_name}">
        <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
      </joint>
      <actuator name="${joint_name}_motor">
        <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
        <mechanicalReduction>1</mechanicalReduction>
      </actuator>
    </transmission>
  </xacro:macro>

  <xacro:transmission_block joint_name="lf_joint1"/>
  <xacro:transmission_block joint_name="lf_joint2"/>
  <xacro:transmission_block joint_name="lb_joint1"/>
  <xacro:transmission_block joint_name="lb_joint2"/>
  <xacro:transmission_block joint_name="rf_joint1"/>
  <xacro:transmission_block joint_name="rf_joint2"/>
  <xacro:transmission_block joint_name="rb_joint1"/>
  <xacro:transmission_block joint_name="rb_joint2"/>
</robot>
