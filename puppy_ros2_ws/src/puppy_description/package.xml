<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>puppy_description</name>
  <version>0.0.1</version>
  <description>ROS2 description package for puppy robot</description>
  <maintainer email="user@example.com">user</maintainer>
  <license>BSD</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Core ROS2 dependencies -->
  <depend>rclpy</depend>
  <depend>robot_state_publisher</depend>
  <depend>rviz2</depend>
  <depend>xacro</depend>
  <depend>joint_state_publisher</depend>
  <depend>joint_state_publisher_gui</depend>

  <!-- Gazebo/IGN dependencies -->
  <depend>ros_gz_sim</depend>
  <depend>ros_gz_bridge</depend>
  <depend>ros_gz_description</depend>

  <!-- Resource dependencies -->
  <depend>ros2launch</depend>
  <depend>ros2run</depend>

  <export>
    <build_type>ament_cmake</build_type>
    
    <!-- Export for Gazebo/IGN -->
    <gazebo_ros gazebo_model_path="${prefix}/.."/>
    <gazebo_ros gazebo_media_path="${prefix}/.."/>
    
    <!-- Export for ROS2 tools -->
    <ros2launch>
      <launch_file>launch/controlled_robot.launch.py</launch_file>
    </ros2launch>
  </export>
</package> 