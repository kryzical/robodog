AMENT_PREFIX_PATH=/opt/ros/humble
COLCON=1
DISPLAY=:0
GAZEBO_MODEL_PATH=/workspace/src:/workspace/models
GAZEBO_RESOURCE_PATH=/workspace/src:/workspace/models
GZ_RESOURCE_PATH=/workspace/models:/workspace/src
GZ_SIM_RESOURCE_PATH=/workspace/models:/workspace/src
GZ_VERSION=garden
HOME=/root
HOSTNAME=kyppy
IGN_FILE_PATH=/workspace/models:/workspace/src
IGN_GAZEBO_RESOURCE_PATH=/workspace/models:/workspace/src
LANG=C.UTF-8
LC_ALL=C.UTF-8
LD_LIBRARY_PATH=/opt/ros/humble/opt/rviz_ogre_vendor/lib:/opt/ros/humble/lib/x86_64-linux-gnu:/opt/ros/humble/lib::/usr/lib/x86_64-linux-gnu/mesa:/usr/lib/x86_64-linux-gnu/mesa-egl:/usr/lib/x86_64-linux-gnu/pulseaudio
MESA_LOADER_DRIVER_OVERRIDE=iris
NVIDIA_DRIVER_CAPABILITIES=all
NVIDIA_VISIBLE_DEVICES=all
OGRE_RESOURCE_PATH=/usr/lib/x86_64-linux-gnu/OGRE-1.9.0
OLDPWD=/workspace
PATH=/opt/ros/humble/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
PWD=/workspace/build/puppy_description
PYTHONPATH=/opt/ros/humble/lib/python3.10/site-packages:/opt/ros/humble/local/lib/python3.10/dist-packages
QT_X11_NO_MITSHM=1
ROS_DISTRO=humble
ROS_LOCALHOST_ONLY=0
ROS_PYTHON_VERSION=3
ROS_VERSION=2
SHLVL=0
TERM=xterm
XAUTHORITY=/tmp/.docker.xauth
_=/usr/bin/colcon
