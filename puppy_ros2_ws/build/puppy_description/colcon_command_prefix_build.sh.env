COLCON=1
DISPLAY=:0
GAZEBO_MODEL_PATH=/workspace/src:/workspace/models
GAZEBO_RESOURCE_PATH=/workspace/src:/workspace/models
GZ_RESOURCE_PATH=/workspace/src:/workspace/models
GZ_SIM_RESOURCE_PATH=/workspace/src:/workspace/models
GZ_VERSION=garden
HOME=/root
HOSTNAME=kyppy
IGN_FILE_PATH=/workspace/src:/workspace/models
IGN_GAZEBO_RESOURCE_PATH=/workspace/src:/workspace/models
LANG=C.UTF-8
LC_ALL=C.UTF-8
LD_LIBRARY_PATH=:/usr/lib/x86_64-linux-gnu/mesa:/usr/lib/x86_64-linux-gnu/mesa-egl:/usr/lib/x86_64-linux-gnu/pulseaudio
LIBGL_ALWAYS_SOFTWARE=1
MESA_LOADER_DRIVER_OVERRIDE=iris
OGRE_RESOURCE_PATH=/usr/lib/x86_64-linux-gnu/OGRE-1.9.0
OLDPWD=/workspace
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
PWD=/workspace/build/puppy_description
QT_X11_NO_MITSHM=1
ROS_DISTRO=humble
SHLVL=0
TERM=xterm
_=/usr/bin/colcon
