<?xml version="1.0"?>
<launch>
    <include file="$(find gazebo_ros)/launch/empty_world.launch">
      <arg name="world_name" value="$(find puppy_description)/worlds/empty.world"/>
      <arg name="debug" value="false" />
      <arg name="gui" value="true" />
      <arg name="paused" value="true"/> <!-- Start paused to ensure proper initialization -->
      <arg name="use_sim_time" value="true"/>
      <arg name="headless" value="false"/>
    </include>

    <!-- Set Gazebo physics parameters -->
    <param name="/gazebo/max_step_size" value="0.001"/>
    <param name="/gazebo/real_time_update_rate" value="1000"/>
    
    <param name="robot_description" command="$(find xacro)/xacro $(find puppy_description)/urdf/puppy.urdf.xacro"/>

    <!-- Spawn the robot with a more stable initial position -->
    <node name="urdf_spawner" pkg="gazebo_ros" type="spawn_model" respawn="false" output="screen" 
          args="-urdf -model puppy -param robot_description -z 0.3
                -J lf_joint1 -0.2 -J lf_joint2 0.4
                -J rf_joint1 -0.2 -J rf_joint2 0.4
                -J lb_joint1 -0.2 -J lb_joint2 0.4
                -J rb_joint1 -0.2 -J rb_joint2 0.4"/>

    <!-- Load controllers -->
    <rosparam file="$(find puppy_description)/config/gazebo_control.yaml" command="load"/>

    <!-- Start controllers with proper delays -->
    <node name="controller_spawner" pkg="controller_manager" type="spawner" respawn="false" ns="/puppy"
          output="screen" args="joint_state_controller"
          launch-prefix="bash -c 'sleep 5; $0 $@'"/>
                          
    <!-- Robot state publisher with reduced rate -->
    <node name="robot_state_publisher" pkg="robot_state_publisher" type="robot_state_publisher" respawn="false" output="screen">
      <param name="publish_rate" value="30"/>
      <remap from="/joint_states" to="/puppy/joint_states" />
    </node>
    
    <!-- Unpause physics after proper initialization -->
    <node name="unpause_physics" pkg="rosservice" type="rosservice" 
          args="call --wait /gazebo/unpause_physics"
          launch-prefix="bash -c 'sleep 7; $0 $@'" />

    <!-- Load position controllers last -->
    <node name="position_controller_spawner" pkg="controller_manager" type="spawner" respawn="false"
          ns="/puppy" output="screen" 
          args="joint1_position_controller
                joint2_position_controller
                joint3_position_controller
                joint4_position_controller
                joint5_position_controller
                joint6_position_controller
                joint7_position_controller
                joint8_position_controller"
          launch-prefix="bash -c 'sleep 10; $0 $@'"/>
</launch>
