<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <!-- Math constants -->
    <xacro:property name="pi" value="3.14159"/>
    
    <!-- Base Link Properties -->
    <xacro:property name="base_length" value="0.24"/>
    <xacro:property name="base_width" value="0.14"/>
    <xacro:property name="base_height" value="0.04"/>
    <xacro:property name="base_mass" value="1.5"/>
    
    <!-- Hip Link Properties -->
    <xacro:property name="hip_length" value="0.04"/>
    <xacro:property name="hip_width" value="0.03"/>
    <xacro:property name="hip_height" value="0.03"/>
    <xacro:property name="hip_mass" value="0.15"/>
    <xacro:property name="hip_offset" value="0.02"/>
    <xacro:property name="hip_link_y_offset" value="0.01"/>
    
    <!-- Upper Leg Link Properties -->
    <xacro:property name="upper_leg_length" value="0.1"/>
    <xacro:property name="upper_leg_width" value="0.02"/>
    <xacro:property name="upper_leg_height" value="0.02"/>
    <xacro:property name="upper_leg_mass" value="0.15"/>
    
    <!-- Lower Leg Link Properties -->
    <xacro:property name="lower_leg_length" value="0.1"/>
    <xacro:property name="lower_leg_width" value="0.015"/>
    <xacro:property name="lower_leg_height" value="0.015"/>
    <xacro:property name="lower_leg_mass" value="0.1"/>
    
    <!-- Joint Properties -->
    <xacro:property name="joint_damping" value="0.5"/>
    <xacro:property name="joint_friction" value="0.5"/>
    <xacro:property name="joint_effort_limit" value="15.0"/>
    <xacro:property name="joint_velocity_limit" value="6.0"/>
</robot>